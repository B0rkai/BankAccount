# Template for ~/.config/bankaccount/web.env (chmod 600). deploy/set-secrets.sh copies it there and
# fills both values in - see docs/linux-daemon-deployment.md. Never commit the filled-in file.

# Tailscale logins (comma-separated) allowed in through `tailscale serve`.
BANKACCOUNT_ALLOWED_LOGINS=you@example.com
# The LAN password's hash (never the password itself) - set by deploy/set-secrets.sh. The daemon
# refuses to start while either value is still this template's placeholder.
BANKACCOUNT_LAN_PASSWORD_HASH=pbkdf2-sha256:600000:...:...
