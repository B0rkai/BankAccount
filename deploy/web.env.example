# Template for ~/.config/bankaccount/web.env (chmod 600) - see deploy/README.md. Never commit the
# filled-in file.

# Tailscale logins (comma-separated) allowed in through `tailscale serve`.
BANKACCOUNT_ALLOWED_LOGINS=you@example.com
# The LAN password's hash, from:
#   docker run --rm -i bankaccount:live bankaccount-daemon --hash-password
# (type the password, then Enter). Never the password itself.
BANKACCOUNT_LAN_PASSWORD_HASH=pbkdf2-sha256:600000:...:...
