# Template for /etc/bankaccount-daemon/bankaccount-daemon.env - see
# docs/linux-daemon-deployment.md. Copy this file there, fill in real values, and
# chmod 600 + chown to the service user so the token isn't world-readable. Never commit the
# filled-in version (with a real token) anywhere.

BANKACCOUNT_DB=/mnt/bankaccount-db/BankAccount.txt
BANKACCOUNT_HOST=100.64.0.1
BANKACCOUNT_PORT=8080
# Generate with: openssl rand -hex 32
BANKACCOUNT_TOKEN=changeme-generate-a-real-random-token
